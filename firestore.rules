rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isRequestingUserAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Cuenta con email verificado que no es anónima (cualquier dominio).
    function isVerifiedUser() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isSecucutEmail() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email.matches('.*@secocut\\.com');
    }

    // Administrador SECOCUT: rol 'admin' en users/{uid} Y email verificado @secocut.com. Un admin de otro
    // dominio, o con el email sin verificar, NO cumple. exists() va antes del get(): sin perfil no hay error.
    function isSecocutAdmin() {
      return isSecucutEmail() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Empresas clientes (módulo de costos de mecanizado) ────────────────────────────────────────────
    // TODAS las ramas exigen email verificado: el registro por email y contraseña sigue abierto y sin
    // esto alguien podría registrarse con el email de un cliente. empresaId y empresasAsignadas los
    // escribe SOLO el servidor (Admin SDK): ver las reglas de users/{userId}.
    function isVerifiedEmail() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Perfil del usuario: exists() ANTES de get() para que un usuario sin perfil dé "denegado", no error.
    function hasUserProfile() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Usuario de la empresa cliente (users/{uid}.empresaId).
    function isEmpresaMember(empresaId) {
      return isVerifiedEmail() && hasUserProfile() &&
             userProfile().get('empresaId', null) == empresaId;
    }

    // Vendedor: @secocut verificado con la empresa en users/{uid}.empresasAsignadas.
    function isVendedorOf(empresaId) {
      return isSecucutEmail() && hasUserProfile() &&
             empresaId in userProfile().get('empresasAsignadas', []);
    }

    function canAccessEmpresa(empresaId) {
      return isSecocutAdmin() || isEmpresaMember(empresaId) || isVendedorOf(empresaId);
    }

    match /users/{userId} {
      // Cada usuario lee su propio perfil; un admin lee cualquiera. (Ninguna pantalla lee el perfil de otro.)
      allow get: if isOwner(userId) || isRequestingUserAdmin();
      allow list: if isRequestingUserAdmin();
      // Solo se crea el propio perfil, con rol 'user' y únicamente estos campos.
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user'
                    && request.resource.data.keys().hasOnly(['id', 'email', 'role', 'name']);
      // Un admin puede cambiar el rol de OTRO usuario (solo 'user' o 'admin'), nunca el
      // propio: como quien actúa sigue siendo admin, siempre queda al menos uno.
      // El dueño solo puede tocar id, email y name; el admin, solo role. empresaId y empresasAsignadas
      // no los escribe nadie desde el cliente (ni el dueño ni un admin): solo el servidor con Admin SDK.
      // Un merge que no cambia valores (el de (app)/layout.tsx) tiene affectedKeys vacío y pasa.
      allow update: if (isOwner(userId)
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['id', 'email', 'name']))
                   || (isRequestingUserAdmin()
                       && request.auth.uid != userId
                       && request.resource.data.role in ['user', 'admin']
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));
      allow delete: if false;
    }

    match /cuttingToolAnalyses/{analysisId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isRequestingUserAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isRequestingUserAdmin());
    }

    match /simulations/{simulationId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isRequestingUserAdmin());
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isRequestingUserAdmin());
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isRequestingUserAdmin());
    }

    // NOTA: no hay ninguna referencia a esta colección en el cliente (2026-08-24).
    // Se deja la regla endurecida por si se crea más adelante.
    match /analisis_costos/{analisisId} {
      allow get: if request.auth != null && (isOwner(resource.data.userId) || isRequestingUserAdmin());
      // list exige que la query filtre por userId: Firestore rechaza toda query
      // que no pueda probar que devuelve solo documentos permitidos.
      allow list: if request.auth != null && (isOwner(resource.data.userId) || isRequestingUserAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (isOwner(resource.data.userId) || isRequestingUserAdmin());
      allow delete: if request.auth != null && (isOwner(resource.data.userId) || isRequestingUserAdmin());
    }

    match /notifications/{notificationId} {
      // Cada notificación va a un destinatario (recipientId = dueño del caso); los admins leen todas.
      allow read: if request.auth != null
                  && (resource.data.recipientId == request.auth.uid || isRequestingUserAdmin());
      allow create: if isRequestingUserAdmin();
      allow update, delete: if isRequestingUserAdmin();
    }

    match /settings/{settingId} {
      // Solo guarda las URL de los logos del PDF: lo leen también usuarios de otros dominios.
      allow read: if isVerifiedUser();
      allow write: if isRequestingUserAdmin();
    }

    // ── Agentes IA ────────────────────────────────────
    match /ai_agents/{agentId} {
      allow read: if isSecucutEmail();
      allow write: if isSecocutAdmin();
    }

    match /knowledge_entries/{entryId} {
      allow read: if isSecucutEmail();
      allow write: if isSecocutAdmin();
    }

    // ── Empresas clientes: costos de mecanizado ───────────────────────────────────────────────────────
    // Documento raíz (el match recursivo de abajo no lo cubre): lo ven los de la empresa, el vendedor
    // asignado y el admin SECOCUT; solo el admin lo crea y lo edita; nadie lo borra.
    match /empresas/{empresaId} {
      allow get: if canAccessEmpresa(empresaId);
      allow list: if isSecocutAdmin();
      allow create, update: if isSecocutAdmin();
      allow delete: if false;
    }

    // Lectura de todo lo que cuelga de la empresa. La ESCRITURA no es genérica a propósito: si lo fuera
    // saltearía la auditoría exigida abajo para máquinas y piezas (un match más permisivo gana).
    match /empresas/{empresaId}/{document=**} {
      allow read: if canAccessEmpresa(empresaId);
    }

    // Datos COMPARTIDOS dentro de la empresa: todos sus usuarios leen, crean, editan y borran. Cada escritura
    // deja auditoría: updatedBy es quien escribe; en la creación también createdBy; createdBy/createdAt no cambian.
    match /empresas/{empresaId}/maquinas/{maquinaId} {
      allow create: if canAccessEmpresa(empresaId)
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if canAccessEmpresa(empresaId)
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if canAccessEmpresa(empresaId);
    }

    match /empresas/{empresaId}/piezas/{piezaId} {
      allow create: if canAccessEmpresa(empresaId)
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if canAccessEmpresa(empresaId)
                    && request.resource.data.updatedBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if canAccessEmpresa(empresaId);
    }

    // Invitaciones a empresas clientes: cerradas a los clientes. Las crea, lista, revoca y canjea SOLO el servidor
    // (rutas /api/costos/invitaciones con Admin SDK), que es también quien escribe users/{uid}.empresaId.
    match /invitaciones/{invitacionId} {
      allow read, write: if false;
    }

    // Contadores de uso diario de las rutas /api: solo los escribe el servidor (Admin SDK).
    match /rate_limits/{counterId} {
      allow read, write: if false;
    }

    match /chat_sessions/{sessionId} {
      // Solo se puede crear una sesión propia (antes se podía crear a nombre de cualquier userId).
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Cada usuario ve y maneja solo lo que creó; el admin SECOCUT ve todo. Una sesión sin campo userId
      // (anterior a esta regla) la ve solo el admin SECOCUT: sin el campo, isOwner(...) da error y solo
      // la otra rama del || puede permitir. Escrito así (igual que analisis_costos) para que una consulta
      // con where('userId', '==', uid) sea demostrable por Firestore.
      allow read, update, delete: if request.auth != null &&
        (isOwner(resource.data.userId) || isSecocutAdmin());
    }

  }
}
