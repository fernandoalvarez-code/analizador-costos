{
  "apphosting": {
    "backendId": "studio",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      ".agents",
      ".idx",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "functions"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    }
  }
}
