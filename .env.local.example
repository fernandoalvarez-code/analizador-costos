# Modo emulador local (solo desarrollo). NO va en apphosting.yaml ni en variables de producción.
# Se usa con `npm run dev:emulador`, que además FUERZA NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-costos en el proceso
# (las variables del shell pisan a .env.local), de modo que nunca apunta a la base real.
# Ver docs/analisis-costos/README-LOCAL.md
NEXT_PUBLIC_USE_EMULATORS=true
